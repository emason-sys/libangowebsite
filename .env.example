# Backend API endpoints (the existing Libango backend that processes submissions)
# Leave unset in development: the site then runs in mock mode and never calls out.
BACKEND_APPLY_URL=
BACKEND_TOKEN_URL=
# Optional bearer/API key sent to the backend as Authorization: Bearer <value>
BACKEND_API_KEY=

# Cloudflare Turnstile — public site key rendered by both the /token and /apply
# widgets AND the /gate portal challenge. Leave unset in local development and
# the pages fall back to a visible placeholder checkbox.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Portal reverse proxy (portal.libangolr.net) — server-side pieces
# ---------------------------------------------------------------
# Cloudflare Turnstile secret key used by /api/portal/verify to call siteverify.
# Get this from the Cloudflare dashboard alongside the site key above. Never
# commit the real value.
TURNSTILE_SECRET_KEY=

# HMAC secret used to sign the portal session cookie (libango_portal). Must be
# at least 32 characters. Generate with: `openssl rand -base64 48`. Rotating
# this invalidates every live session, forcing re-verification on the next hit.
PORTAL_COOKIE_SECRET=

# Backend origin the portal nginx server block reverse-proxies to. The Next.js
# app itself does not read this — it is here for documentation and for the
# nginx config template to reference. Set in nginx, not in this env file.
# PORTAL_BACKEND_URL=http://10.0.1.177:3001
